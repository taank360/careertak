# Optional – enables real Claude-powered AI (counsellor chat, resume review, interview feedback).
# Without it the app runs fully on its built-in offline AI engine.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
PORT=8787

# Optional – cloud database for login, multi-device sync and the placement-cell dashboard.
# Supabase → Project Settings → API. The anon key is safe to expose in the browser (RLS protects data).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
